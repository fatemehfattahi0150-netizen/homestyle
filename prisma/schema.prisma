generator client {
  provider = "prisma-client"
  output   = "../app/generated/prisma"
}

datasource db {
  provider = "mysql"
}

model Product {
  id          Int      @id @default(autoincrement())
  name        String
  price       String
  category    String
  description String   @db.Text
  images      Json
  sizes       Json
  colors      Json
  isFeatured  Boolean  @default(false)
  collections Json
  stock       Int      @default(0)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}